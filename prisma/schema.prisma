// Event Management System - Database Schema
// SQLite (sandbox). Enums are stored as validated strings (see src/lib/constants.ts).
// All IDs are UUID v4 generated by Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS & TEAMS ============

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  fullName       String
  hashedPassword String
  // EVENT_MANAGER | TEAM_LEADER | EMPLOYEE
  role           String   @default("EMPLOYEE")
  isActive       Boolean  @default(true)
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Multi-tenant room membership. Null = "pending onboarding": the user must
  // create a room (becoming its owner/EVENT_MANAGER) or join one via
  // room_code + password before any data endpoint unlocks.
  roomId         String?
  room           Room?    @relation("RoomMembers", fields: [roomId], references: [id], onDelete: SetNull)
  ownedRooms     Room[]   @relation("OwnedRooms")
  // JSON-serialized map of NotificationType -> boolean (enabled). Missing key = enabled.
  notificationPrefs String?
  // Workflow guard: when true, this user cannot mark a task COMPLETED while any
  // of its dependencies is unfinished (enforced server-side, 409).
  strictDependencyGuard Boolean @default(false)
  // Profile customization: self-uploaded photo (client-resized data URL, JPEG,
  // max ~256px) and a chosen cover background key from the preset gallery.
  avatarUrl    String?
  profileBg    String?

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  managedTeams   Team[]         @relation("ManagedTeams")
  createdEvents  Event[]
  assignedTasks  Task[]         @relation("AssignedTasks")
  createdTasks   Task[]         @relation("CreatedTasks")
  comments       TaskComment[]
  notifications  Notification[]
  activities     ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([teamId])
  @@index([role])
  @@index([roomId])
}

// ============ ROOMS (multi-tenant isolation) ============

/// An isolated tenant workspace. Every team/event/task/user belongs to exactly
/// one room; all reads and writes are scoped by the caller's roomId.
model Room {
  id           String  @id @default(uuid())
  /// Human-readable share code, e.g. EVT-7X9K2M (no O/0/I/1).
  roomCode     String  @unique
  name         String
  description  String?
  /// scrypt hash (same scheme as user passwords) — required to join.
  passwordHash String
  ownerId      String
  owner        User    @relation("OwnedRooms", fields: [ownerId], references: [id])
  isActive     Boolean @default(true)
  /// Optional membership cap enforced at join time.
  maxMembers   Int?
  members      User[]  @relation("RoomMembers")

  teams       Team[]
  events      Event[]
  tasks       Task[]
  comments    TaskComment[]
  activities  ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([roomCode])
}

model Team {
  id          String  @id @default(uuid())
  // Unique per room (multi-tenant) — two rooms may both have a "Operations".
  name        String
  roomId      String?
  room        Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  description String?
  managerId   String?
  manager     User?   @relation("ManagedTeams", fields: [managerId], references: [id], onDelete: SetNull)
  members     User[]
  events      Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, name])
  @@index([managerId])
  @@index([roomId])
}

// ============ EVENTS ============

model Event {
  id          String  @id @default(uuid())
  name        String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime
  // DRAFT | PLANNING | IN_PROGRESS | COMPLETED | CANCELLED
  status      String  @default("DRAFT")
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Denormalized from team.roomId for cheap room-scoped reads (backfilled).
  roomId      String?
  room        Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy   String
  creator     User    @relation(fields: [createdBy], references: [id])
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([startDate])
  @@index([roomId])
}

// ============ TASKS ============

model Task {
  id             String  @id @default(uuid())
  title          String
  description    String?
  // HIGH | MEDIUM | LOW
  priority       String  @default("MEDIUM")
  // NOT_STARTED | IN_PROGRESS | BLOCKED | COMPLETED
  status         String  @default("NOT_STARTED")
  eventId        String
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Denormalized from event.roomId for cheap room-scoped reads (backfilled).
  roomId         String?
  room           Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignedTo     String?
  assignee       User?   @relation("AssignedTasks", fields: [assignedTo], references: [id], onDelete: SetNull)
  createdBy      String
  creator        User    @relation("CreatedTasks", fields: [createdBy], references: [id])
  // Optional scheduled start; when set, timeline bars run start → due.
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?

  comments     TaskComment[]
  dependencies TaskDependency[] @relation("TaskDeps")
  dependents   TaskDependency[] @relation("DependsOnDeps")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@index([roomId])
}

model TaskComment {
  id      String @id @default(uuid())
  content String
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Denormalized from task.roomId — room-scoped comment feeds.
  roomId  String?
  room    Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([roomId])
}

model TaskDependency {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)

  dependsOnTaskId String
  dependsOnTask   Task   @relation("DependsOnDeps", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

// ============ NOTIFICATIONS & ACTIVITY ============

model Notification {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  message String
  // TASK_ASSIGNED | TASK_STATUS_CHANGED | TASK_COMPLETED | TASK_BLOCKED | COMMENT_ADDED | DEADLINE_APPROACHING
  type    String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model ActivityLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  action String
  // Room the activity belongs to (actor's room at write time) — the org-wide
  // feed is room-scoped, never global.
  roomId String?
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  // JSON-serialized details (SQLite has no native Json type in Prisma)
  details String?

  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([roomId])
}

// ============ AUTH SESSIONS ============

model Session {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  // Captured at sign-in (User-Agent header); shown in the profile session manager.
  userAgent String?
  // Refreshed opportunistically when a session is resolved and >60s stale.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ============ PASSWORD RESET ============

model PasswordResetToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Single-use: set when the token is consumed by /api/auth/reset-password.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
