# ── Eventship environment reference ──────────────────────────────
# Copy this file to ".env" and fill in real values. Never commit .env.

# ── Local development (SQLite — default, zero setup) ──
DATABASE_URL="file:./db/custom.db"

# ── Production (PostgreSQL — e.g. Neon) ──────────────────────────
# 1) In prisma/schema.prisma change:  provider = "sqlite" → "postgresql"
# 2) Paste your connection string below.
#
# LOCAL SETUP + SEEDING → use the DIRECT (unpooled) string:
# DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
#
# VERCEL RUNTIME → use the POOLED string (host contains "-pooler"):
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#
# Then:  npx prisma db push  &&  npx tsx prisma/seed.ts
